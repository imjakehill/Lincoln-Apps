@page "/createreq"
@inject NotificationService Notif
@inject NavigationManager Nav
@inject SesionService Sesion
@inject BasApiClient BasApi
@inject RequerimientoService ReqService
@inject IJSRuntime JS
@using System.Diagnostics

@* ═══════════════════════════════════════════════════════════════
   CreateReq.razor — Formulario de carga de requerimiento (RQ)

   ESTRUCTURA:
   ├── Header          (usuario, logo, idioma)
   ├── Subheader       (N° req, título, estado)
   ├── Campos header   (Budget, Fecha, Solicitante, Prefijo, etc.)
   ├── Tabla de ítems  (con paginación, máx 3 filas visibles)
   ├── Footer          (VOLVER / HECHO)
   └── Modal           (confirmación al presionar HECHO)
   ═══════════════════════════════════════════════════════════════ *@

<PageTitle>Lincoln — Carga de Requerimiento</PageTitle>

<div class="pagina-completa">

    @* ── HEADER ─────────────────────────────────────────────── *@
    <header class="cr-header">
        <div class="header-usuario">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.029 10 8 10c-2.029 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
            </svg>
            <span>@Sesion.userName.ToUpper()</span>
        </div>
        <div class="header-logo">
            <img src="/Assets/logoLincoln.jpg" alt="Logo Lincoln" class="logo-img" />
        </div>
        <div class="header-idioma">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M4.545 6.714 4.11 8H3l1.862-5h1.284L8 8H6.833l-.435-1.286H4.545zm1.634-.736L5.5 3.956h-.049l-.679 2.022H6.18z"/>
                <path d="M0 2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-3H2a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H2zm7.138 9.995c.193.301.402.583.63.846-.748.575-1.673 1.001-2.768 1.292.178.217.451.635.555.867 1.125-.359 2.08-.844 2.886-1.494.777.665 1.739 1.165 2.93 1.472.133-.254.414-.673.629-.89-1.125-.253-2.057-.694-2.82-1.284.681-.747 1.222-1.651 1.621-2.757H14v-.88h-3v-.73h-.89v.73h-3v.88h1.185c.351.998.85 1.909 1.504 2.648-.315.283-.655.54-1.022.767z"/>
            </svg>
            <select class="selector-idioma" @bind="IdiomaSeleccionado">
                <option value="es">Español</option>
                <option value="en">English</option>
            </select>
        </div>
    </header>

    @* ── CUERPO AZUL ─────────────────────────────────────────── *@
    <main class="cr-cuerpo">

        @* ── BANNER DE NOTIFICACIÓN (NotificationService) ────── *@
        @if (Notif.Activa)
        {
            <div class="banner-notif banner-@(Notif.Tipo == TipoNotificacion.Exito ? "exito" : "error")">
                <span class="banner-icono">
                    @if (Notif.Tipo == TipoNotificacion.Exito)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 4a.905.905 0 0 0-.9.995l.35 3.507a.552.552 0 0 0 1.1 0l.35-3.507A.905.905 0 0 0 8 4zm.002 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" />
                        </svg>
                    }
                </span>
                <span class="banner-texto">@Notif.Mensaje</span>
                <button class="banner-cerrar" @onclick="Notif.Limpiar">✕</button>
            </div>
        }

        @* ── SUBHEADER: N° req / título / estado ─────────────── *@
        <div class="cr-subheader">
            <div class="req-numero">
                <span class="req-label">Requerimiento N°</span>
                <span class="req-valor">@NroRequerimiento</span>
            </div>
            <div class="req-titulo-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"/>
                    <path d="M4.5 8a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0-2.5a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0 5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1h-4z"/>
                </svg>
                <span>Carga de requerimiento</span>
            </div>
            <div class="req-estado">
                <span class="estado-label">Estado</span>
                <span class="estado-badge estado-en-proceso">
                    <span class="estado-dot"></span>
                    En proceso
                </span>
            </div>
        </div>

        @* ── CAMPOS DEL FORMULARIO ────────────────────────────── *@
        <div class="cr-campos">

            @* Columna izquierda *@
            <div class="campos-col">

                @* Solicitante — texto libre, no obligatorio *@
                <div class="campo-grupo">
                    <label class="campo-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/>
                        </svg>
                        Solicitante
                    </label>
                    <input class="campo-input campo-input-md"
                           type="text"
                           @bind="Solicitante"
                           @bind:event="oninput"
                           placeholder="Ingrese solicitante" />
                </div>

                @* Centro de Apropiación (= departamento) — se carga desde USUARIO_CENTROAP
                   según el usuario logueado. Varios → dropdown; uno solo → no editable. *@
                <div class="campo-grupo">
                    <label class="campo-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M6.5 0a.5.5 0 0 0-.5.5V3H1.5A1.5 1.5 0 0 0 0 4.5V14H8v-3h.5a.5.5 0 0 1 .5.5v2.5H16V5.5A1.5 1.5 0 0 0 14.5 4H10V.5a.5.5 0 0 0-.5-.5h-3zM2 7h1v1H2V7zm2 0h1v1H4V7zm-2 2h1v1H2V9zm2 0h1v1H4V9zm-2 2h1v1H2v-1zm2 0h1v1H4v-1zM7 5h1v1H7V5zm2 0h1v1H9V5zM7 7h1v1H7V7zm2 0h1v1H9V7zm2 0h1v1h-1V7zm2 0h1v1h-1V7zM7 9h1v1H7V9zm2 0h1v1H9V9zm2 0h1v1h-1V9zm2 0h1v1h-1V9zm-4 2h1v1h-1v-1zm2 0h1v1h-1v-1zm2 0h1v1h-1v-1z"/>
                        </svg>
                        Centro de Apropiación
                    </label>

                    @if (CentrosAp.Count == 0)
                    {
                        <div class="campo-readonly-box">
                            <span class="campo-readonly-value">—</span>
                            <span class="campo-readonly-hint">sin centro</span>
                        </div>
                    }
                    else if (CentrosAp.Count == 1)
                    {
                        @* Un solo centro → no editable, ya seleccionado *@
                        <div class="campo-readonly-box">
                            <span class="campo-readonly-value">@CentrosAp[0].Nombre</span>
                            <span class="campo-readonly-hint">del usuario</span>
                        </div>
                    }
                    else
                    {
                        @* Varios centros → dropdown para elegir *@
                        <select class="campo-input campo-input-md" @bind="CentroApSeleccionado">
                            <option value="">-- Seleccioná un centro --</option>
                            @foreach (var c in CentrosAp)
                            {
                                <option value="@c.Key">@c.Nombre</option>
                            }
                        </select>
                    }
                </div>

                @* Comentarios Internos de Compras — campo nuevo.
                   Solo se muestra y es editable si el departamento del usuario es "Compras". *@
                @if (EsCompras)
                {
                    <div class="campo-grupo">
                        <label class="campo-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                            </svg>
                            Comentarios Internos Compras
                        </label>
                        <input class="campo-input campo-input-md"
                               type="text"
                               @bind="ComentariosInternosCompras"
                               @bind:event="oninput"
                               maxlength="500"
                               placeholder="Comentarios..." />
                    </div>
                }

            </div>

            @* Columna central *@
            <div class="campos-col">

                @* Fecha Requerida — date picker, obligatorio, sin fechas pasadas *@
                <div class="campo-grupo">
                    <label class="campo-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                        </svg>
                        Fecha Requerida <span class="campo-asterisco">*</span>
                    </label>
                    <input class="campo-input campo-fecha campo-input-md"
                           type="date"
                           @bind="FechaRequerida"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                @* Tipo de pedido — badge dinámico calculado desde FechaRequerida *@
                <div class="campo-grupo">
                    <label class="campo-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                        </svg>
                        Prioridad
                    </label>
                    <div class="tipo-pedido-badge tipo-@TipoPedido.ToLowerInvariant().Replace("á","a")">
                        @TipoPedido
                    </div>
                </div>

                @* Prefijo — editable *@
                <div class="campo-grupo">
                    <label class="campo-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2.97 1.35A1 1 0 0 1 3.73 1h8.54a1 1 0 0 1 .76.35l2.609 3.044A1.5 1.5 0 0 1 16 5.37v.255a2.375 2.375 0 0 1-4.25 1.458A2.371 2.371 0 0 1 9.875 8 2.37 2.37 0 0 1 8 7.083 2.37 2.37 0 0 1 6.125 8a2.37 2.37 0 0 1-1.875-.917A2.375 2.375 0 0 1 0 5.625V5.37a1.5 1.5 0 0 1 .361-.976l2.61-3.045zm1.78 4.275a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0 1.375 1.375 0 1 0 2.75 0V5.37a.5.5 0 0 0-.12-.325L12.27 2H3.73L1.12 5.045A.5.5 0 0 0 1 5.37v.255a1.375 1.375 0 0 0 2.75 0 .5.5 0 0 1 1 0zM1.5 8.5A.5.5 0 0 1 2 9v6h12V9a.5.5 0 0 1 1 0v6h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1V9a.5.5 0 0 1 .5-.5z"/>
                        </svg>
                        Prefijo
                    </label>
                    <div class="campo-readonly-box">
                        <span class="campo-readonly-value">@(string.IsNullOrWhiteSpace(Prefijo) ? "—" : Prefijo)</span>
                        <span class="campo-readonly-hint campo-readonly-hint-tal">
                            @(string.IsNullOrWhiteSpace(Talonario) ? "Sin talonario" : $"Talonario {Talonario}")
                        </span>
                    </div>
                </div>

            </div>

            @* Columna derecha *@
            <div class="campos-col campos-col-derecha">

                @* Observación — textarea, opcional, máx 500 + contador *@
                <div class="campo-grupo campo-grupo-obs">
                    <label class="campo-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                        </svg>
                        Observación del RQ
                        <span class="campo-contador">@Observacion.Length / 500</span>
                    </label>
                    <textarea class="campo-textarea"
                              @bind="Observacion"
                              @bind:event="oninput"
                              maxlength="500"
                              placeholder="Detalles, contexto o aclaraciones del pedido..."
                              rows="4"></textarea>
                </div>

                @* Autorización adjunta — carga de archivo (PDF/JPG/PNG).
                   Aún no se sube a BAS (pendiente de aprobación): por ahora se valida
                   la extensión y se retiene el archivo en memoria (ArchivoAutorizacion). *@
                <div class="campo-grupo">
                    <label class="campo-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0V3z"/>
                        </svg>
                        Autorización adjunta
                    </label>

                    <label class="campo-dropzone">
                        <InputFile OnChange="OnAutorizacionSeleccionada"
                                   accept=".png,.jpg,.jpeg,.pdf"
                                   class="dropzone-input" />
                        @if (string.IsNullOrEmpty(NombreArchivoAutorizacion))
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/>
                            </svg>
                            <span class="dropzone-text">Adjuntar archivo</span>
                            <span class="dropzone-formats">PDF · JPG · PNG</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 13.707 4L10 .293A1 1 0 0 0 9.293 0zM9.5 3.5v-2l3 3h-2a1 1 0 0 1-1-1z"/>
                            </svg>
                            <span class="dropzone-text">@NombreArchivoAutorizacion</span>
                            <span class="dropzone-formats">@TamanoArchivoAutorizacion</span>
                        }
                    </label>

                    @if (!string.IsNullOrEmpty(NombreArchivoAutorizacion))
                    {
                        <button type="button" class="dropzone-quitar" @onclick="QuitarAutorizacion">
                            Quitar archivo
                        </button>
                    }
                </div>

            </div>

        </div>

        @* ── TABLA DE ÍTEMS ───────────────────────────────────── *@
        <div class="cr-tabla-contenedor">

            @* Encabezado de tabla con botón + *@
            <div class="tabla-topbar">
                <button class="btn-agregar" @onclick="AgregarFila" title="Agregar ítem">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                    </svg>
                </button>
                <span class="tabla-col-header">COD ITEM</span>
                <span class="tabla-col-header">RUBRO</span>
                <span class="tabla-col-header">SUBRUBRO</span>
                <span class="tabla-col-header">CANTIDAD</span>
                <span class="tabla-col-header">U. DE MEDIDA</span>
                <span class="tabla-col-header">CANT. UDM</span>
                <span class="tabla-col-header">ADJUNTO</span>
                <span class="tabla-col-header">PROVEEDOR SUG.</span>
                <span class="tabla-col-header">OBSERVACIÓN ÍTEM</span>
                <span class="tabla-col-header"></span>
            </div>

            @* Filas paginadas (máx 3 visibles) *@
            @foreach (var fila in FilasPaginadas)
            {
                <div class="tabla-fila" @onkeydown="OnFilaKeyDown">

                    @* ITEM — número correlativo, solo lectura *@
                    <input class="celda-input celda-readonly" type="text"
                           value="@fila.Item" readonly />

                    @* COD ITEM — solo lectura, se carga únicamente desde la lupa (catálogo) *@
                    <div class="celda-coditem">
                        <input class="celda-input celda-readonly" type="text"
                               value="@fila.CodItem"
                               readonly
                               placeholder="Cod." />
                        <button type="button"
                                class="btn-lupa-cell"
                                @onclick="() => AbrirModalItems(fila)"
                                title="Buscar item del catálogo">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                        </button>
                    </div>

                    @* RUBRO — autocompletado desde el ítem (lupa), solo lectura *@
                    <input class="celda-input celda-readonly" type="text"
                           value="@fila.Rubro" readonly placeholder="Rubro" />

                    @* SUBRUBRO — autocompletado desde el ítem (lupa), solo lectura *@
                    <input class="celda-input celda-readonly" type="text"
                           value="@fila.Subrubro" readonly placeholder="Subrubro" />

                    @* CANTIDAD — editable *@
                    <input class="celda-input" type="number"
                           @bind="fila.Cantidad"
                           @bind:event="oninput"
                           placeholder="0" min="0" />

                    @* U. DE MEDIDA — según el ítem: 2 unidades → combobox; 1 → readonly; 0 → "NA" *@
                    @if (fila.UnidadesDisponibles.Count == 2)
                    {
                        <select class="celda-input" @bind="fila.UnidadMedida">
                            @foreach (var u in fila.UnidadesDisponibles)
                            {
                                <option value="@u">@u</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input class="celda-input celda-readonly" type="text"
                               value="@fila.UnidadMedida" readonly placeholder="Unidad" />
                    }

                    @* CANTIDAD U.D.M. — editable *@
                    <input class="celda-input" type="number"
                           @bind="fila.CantidadUDM"
                           @bind:event="oninput"
                           placeholder="0" min="0" />

                    @* ARCH. ADJUNTO — placeholder visual.
                       TODO: implementar InputFile pdf/jpg/png *@
                    <div class="celda-adjunto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0V3z"/>
                        </svg>
                    </div>

                    @* PROVEEDOR SUGERIDO — texto libre opcional + botón lupa para catálogo *@
                    <div class="celda-coditem">
                        <input class="celda-input" type="text"
                               @bind="fila.ProveedorSugerido"
                               @bind:event="oninput"
                               placeholder="Proveedor" />
                        <button type="button"
                                class="btn-lupa-cell"
                                @onclick="() => AbrirModalProveedores(fila)"
                                title="Buscar proveedor del catálogo">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
