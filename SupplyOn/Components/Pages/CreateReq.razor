    // ── Tabla y paginación ────────────────────────────────────

    private const int FilasPorPagina = 3;
    private int PaginaActual = 1;

    private List<FilaItem> Filas { get; set; } = new()
    {
        new FilaItem { Item = 1 }
    };

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling((double)Filas.Count / FilasPorPagina));
    private int PaginaInicio => (PaginaActual - 1) * FilasPorPagina + 1;
    private int PaginaFin    => Math.Min(PaginaActual * FilasPorPagina, Filas.Count);

    private IEnumerable<FilaItem> FilasPaginadas =>
        Filas.Skip((PaginaActual - 1) * FilasPorPagina).Take(FilasPorPagina);

    private void PrimeraPagina()   => PaginaActual = 1;
    private void UltimaPagina()    => PaginaActual = TotalPaginas;
    private void PaginaAnterior()  { if (PaginaActual > 1) PaginaActual--; }
    private void PaginaSiguiente() { if (PaginaActual < TotalPaginas) PaginaActual++; }

    // Enter en cualquier input dentro de una fila → agrega nueva fila.
    // Aprovecha event bubbling: el handler está en el div .tabla-fila
    // y captura el keydown que sube desde cualquier <input> descendiente.
    private void OnFilaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AgregarFila();
    }

    private void AgregarFila()
    {
        Filas.Add(new FilaItem { Item = Filas.Count + 1 });
        PaginaActual = TotalPaginas;
    }

    private void EliminarFila(FilaItem fila)
    {
        Filas.Remove(fila);
        for (int i = 0; i < Filas.Count; i++)
            Filas[i].Item = i + 1;
        if (PaginaActual > TotalPaginas)
            PaginaActual = TotalPaginas;
    }

    // ── Modal y guardado ──────────────────────────────────────

    private bool   MostrarModal       { get; set; } = false;
    private bool   Guardando          { get; set; } = false;
    private string MensajeValidacion  { get; set; } = string.Empty;

    private void MostrarConfirmacion()
    {
        MensajeValidacion = string.Empty;

        if (!ValidarFormulario(out string msg))
        {
            MensajeValidacion = msg;
            return;
        }

        MostrarModal = true;
    }

    private void CerrarModal() => MostrarModal = false;

    private bool ValidarFormulario(out string mensaje)
    {
        if (FechaRequerida.Date < DateTime.Today)
        {
            mensaje = "La fecha requerida no puede ser anterior a hoy.";
            return false;
        }

        if (Observacion.Length > 500)
        {
            mensaje = "La observación supera los 500 caracteres.";
            return false;
        }

        // Debe haber al menos una fila con CodItem cargado (sin código no hay item válido para BAS).
        bool hayItemConCodigo = Filas.Any(f => !string.IsNullOrWhiteSpace(f.CodItem));
        if (!hayItemConCodigo)
        {
            mensaje = "Debe cargar al menos un ítem con código.";
            return false;
        }

        mensaje = string.Empty;
        return true;
    }

    private ComprobanteCompraRequest ConstruirRequest()
    {
        // Réplica del Program.cs original que funcionó en LincolnTEST.
        // Mantengo del formulario lo que el usuario carga: Prefijo, Observación,
        // Usuario logueado, Proveedor (si lo escribió) y CodItem de cada fila.
        // El resto va HARDCODEADO igual al original — cuando esté la base SQL
        // se reemplazan los hardcodes por los valores reales del UI.
        static string? V(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

        string prefijoFinal = string.IsNullOrWhiteSpace(Prefijo) ? "0001" : Prefijo.Trim();
        string usuarioFinal = string.IsNullOrWhiteSpace(Sesion.userName) ? "daniponce" : Sesion.userName; // cambiar esta hardcodeando el usuario

        var req = new ComprobanteCompraRequest
        {
            // ── Cabecera (replica del Program.cs original) ───────
            FechaCreacion          = DateTime.UtcNow.ToString("o"),
            Fecha                  = DateTime.Today.ToString("yyyy-MM-dd"),
            Comprobante            = "RQ",
            Prefijo                = prefijoFinal,
            Numero                 = 0,                                    // bas asigna
            //Proveedor              = V(Proveedor),
            //Nombre                 = V(NombreProveedor) ?? "Proveedor de Prueba",
            MonedaCtaCte           = "",
            MonedaComprobante      = "",
            TotalGravado           = 1000m,
            TotalIva               = 210m,
            Total                  = 1210m,
            MetodoPago             = "C",
            Caja                   = "0001",
            Comprador              = "COM",
            Empresa                = 1,
            Sucursal               = Sucursal,                             
            ImputacionContable     = ImputacionContable,                   
            Deposito               = Deposito,                             
            Usuario                = usuarioFinal,
            NumeroCAIoCAE          = "",
            ObservacionComprobante = V(Observacion),                       // solo si el usuario escribió
        };

        // ── Items (replica del original) ──────────────────────
        // ValidarFormulario garantiza que al menos una fila tiene CodItem antes de llegar acá.
        var filasConDatos = Filas
            .Where(x => x.Cantidad > 0 || !string.IsNullOrWhiteSpace(x.CodItem))
            .ToList();

        foreach (var f in filasConDatos)
        {
            req.Items.Add(new ItemRequest
            {
                CodigoItem               = V(f.CodItem),
                // BAS exige "1" o "2" según cuál unidad del ítem esté elegida en la U. de Medida.
                NumeroUnidadMedida       = (!string.IsNullOrWhiteSpace(f.Unidad2) && f.UnidadMedida == f.Unidad2) ? "2" : "1",
                CentroApropiacionA       = CentroApSeleccionado,
                CantidadPrimeraUnidad    = f.UnidadMedida==f.Unidad2 ? 0 : f.CantidadUDM,
                CantidadSegundaUnidad    = f.UnidadMedida==f.Unidad1 ? 0 : f.CantidadUDM,
                PrecioUnitario           = 1000m,
                ImporteTotal             = 1210m,
                ImporteGravado           = 1000m,
                ImporteIva               = 210m,
                TasaIva                  = 21m,
                PendienteRemitirFacturar = PendienteRemitirFacturarDefault, // "A"
                TipoEntrega              = TipoEntregaDefault,              // "O"
            });
        }

        // ── Vencimientos y Efectivos (estaban en el original) ─
        req.Vencimientos = new List<Vencimiento>
        {
            new Vencimiento
            {
                FechaVencimiento = DateTime.Today.ToString("yyyy-MM-dd"),
                Importe          = 1210m
            }
        };

        req.Efectivos = new List<Efectivo>
        {
            new Efectivo
            {
                MedioPago = "EFE",
                Importe   = 1210m,
                Cantidad  = 1
            }
        };

        return req;
    }

    private async Task ConfirmarCarga()
    {
        if (Guardando) return;

        var logger = new AppHelper();
        logger.GenerateLog("info", $"Carga iniciada — req N° {NroRequerimiento}, {Filas.Count} ítems, usuario={Sesion.userName}");

        Guardando = true;
        StateHasChanged();

        BasApiResult result;
        try
        {
            var req = ConstruirRequest();
            result = await BasApi.EnviarComprobanteCompraAsync(req);
        }
        catch (Exception ex)
        {
            // Excepción no manejada por el cliente — la encapsulo igual para el flujo unificado.
            result = new BasApiResult { IsSuccess = false, ErrorMessage = ex.Message };
            logger.GenerateLog("error", $"Excepción al enviar comprobante: {ex}");
            await TryConsoleLogAsync("error", "[SupplyOn] Excepción inesperada", ex.ToString());
        }

        Guardando    = false;
        MostrarModal = false;

        if (result.IsSuccess)
        {
            string nroFinal = result.Response?.Comprobantes?.FirstOrDefault()?.NumeroFinal ?? NroRequerimiento;
            logger.GenerateLog("info", $"Carga OK — N° {nroFinal} (status {result.Status})");
            Notif.Mostrar($"Requerimiento N° {nroFinal} cargado correctamente.", TipoNotificacion.Exito);
            Nav.NavigateTo("/home");
            return;
        }

        // ── Falla: loguear todo, mostrar al usuario, escupir a la consola del browser ──
        string mensajeLimpio = ExtraerMensajeError(result);

        logger.GenerateLog("error",
            $"Carga FAIL — endpoint={result.Endpoint} status={result.Status} " +
            $"errorMsg={result.ErrorMessage} rawBody={result.RawBody}");

        await TryConsoleLogAsync("group", "[SupplyOn] Falla al cargar requerimiento", string.Empty);
        await TryConsoleLogAsync("log",   "Endpoint:",     result.Endpoint);
        await TryConsoleLogAsync("log",   "Status HTTP:",  result.Status.ToString());
        await TryConsoleLogAsync("log",   "Request JSON:", result.RequestJson ?? string.Empty);
        await TryConsoleLogAsync("error", "Response body:", result.RawBody ?? string.Empty);
        if (!string.IsNullOrEmpty(result.ErrorMessage))
            await TryConsoleLogAsync("error", "Excepción:", result.ErrorMessage);
        await TryConsoleLogAsync("groupEnd", string.Empty, string.Empty);

        // El error se muestra IN-PAGE en CreateReq (no se redirige a Home).
        // Usamos el mismo banner rojo de validación local.
        MensajeValidacion = mensajeLimpio;
        StateHasChanged();
    }

    // Extrae el "title" si la respuesta es un ProblemDetails (JSON con "title"),
    // sino devuelve el body crudo truncado. Si hubo excepción, devuelve esa.
    private static string ExtraerMensajeError(BasApiResult r)
    {
        if (!string.IsNullOrEmpty(r.ErrorMessage))
            return $"Error de red: {r.ErrorMessage}";

        if (!string.IsNullOrEmpty(r.RawBody))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(r.RawBody);
                if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object
                    && doc.RootElement.TryGetProperty("title", out var titleProp))
                {
                    string? title = titleProp.GetString();
                    if (!string.IsNullOrWhiteSpace(title))
                        return title;
                }
            }
            catch { /* no era JSON parseable, caigo al body crudo */ }

            return $"HTTP {r.Status}: {Truncar(r.RawBody, 500)}";
        }

        return $"Falla sin detalle (HTTP {r.Status}).";
    }

    // Helper: escribe en la consola del navegador. Si falla (prerender / cierre), lo ignora.
    private async Task TryConsoleLogAsync(string level, string label, string payload)
    {
        try
        {
            // Mapeo level → console.X
            string fn = level switch
            {
                "error"    => "console.error",
                "warn"     => "console.warn",
                "group"    => "console.group",
                "groupEnd" => "console.groupEnd",
                _          => "console.log"
            };

            if (fn == "console.groupEnd")
                await JS.InvokeVoidAsync(fn);
            else if (string.IsNullOrEmpty(payload))
                await JS.InvokeVoidAsync(fn, label);
            else
                await JS.InvokeVoidAsync(fn, label, payload);
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"[CreateReq] consola browser no disponible: {ex.Message}");
        }
    }

    private static string Truncar(string s, int max) =>
        string.IsNullOrEmpty(s) ? string.Empty : (s.Length > max ? s.Substring(0, max) + "..." : s);

