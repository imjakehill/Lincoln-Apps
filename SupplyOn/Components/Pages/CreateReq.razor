@code {

    // ── Protección de ruta ────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Sesion.isAuthenticated)
            Nav.NavigateTo("/login", replace: true);

        if (firstRender)
        {
            // Catálogo de items desde SQL: SELECT CODITEM, DESCRIPCION FROM ITEMS
            await CargarCatalogoItemsAsync();

            // Catálogo de proveedores desde SQL: SELECT CODCTACTE, NOMBRE, FANTASIA FROM ctactes WHERE cueprefi='P'
            await CargarCatalogoProveedoresAsync();

            // Departamento = usuario logueado (mientras no haya base con la relación real).
            // TODO SQL futuro: SELECT depto FROM Usuarios WHERE username = @Sesion.userName
            Departamento = string.IsNullOrWhiteSpace(Sesion.userName) ? "daniponce" : Sesion.userName;

            // Prefijo (NO editable) desde el talonario RQ del usuario logueado.
            // Si el usuario no tiene talonario o XXXPREFIJO es NULL → "N/A".
            try
            {
                string usuarioPrefijo = string.IsNullOrWhiteSpace(Sesion.userName) ? "testrq" : Sesion.userName;
                var (pref, tal) = await ReqService.GetPrefijoUsuarioAsync(usuarioPrefijo);
                Prefijo   = pref ?? "N/A";
                Talonario = tal ?? string.Empty;
            }
            catch (Exception ex)
            {
                Debug.WriteLine($"[ERROR CreateReq] obteniendo prefijo del talonario: {ex.Message}");
                Prefijo   = "N/A";
                Talonario = string.Empty;
            }

            // Centros de Apropiación del usuario logueado (= su departamento).
            try
            {
                string usuarioCentro = string.IsNullOrWhiteSpace(Sesion.userName) ? "testrq" : Sesion.userName;
                var centros = await ReqService.GetCentrosApUsuarioAsync(usuarioCentro);
                CentrosAp = centros
                    .Select(c => new CentroApOption { Prefijo = c.Prefijo, CodCen = c.CodCen, Nombre = c.Nombre })
                    .ToList();

                // Si tiene uno solo, queda preseleccionado.
                CentroApSeleccionado = CentrosAp.Count == 1 ? CentrosAp[0].Key : string.Empty;
            }
            catch (Exception ex)
            {
                Debug.WriteLine($"[ERROR CreateReq] obteniendo centros AP: {ex.Message}");
                CentrosAp = new();
                CentroApSeleccionado = string.Empty;
            }

            // Próximo N° de requerimiento desde TRANSAC (max+1).
            // BAS termina asignando el N° real al recibir el POST con Numero=0,
            // pero mostramos el predicho para que el usuario lo vea desde el inicio.
            try
            {
                Correlativo = await ReqService.GetProximoNumeroAsync();
            }
            catch (Exception ex)
            {
                Debug.WriteLine($"[ERROR CreateReq] obteniendo próximo NROTRANS: {ex.Message}");
            }

            ActualizarNroRequerimiento();
            StateHasChanged();
        }
    }

    // ── Modelo de fila de la tabla ────────────────────────────
    private class FilaItem
    {
        public int Item                { get; set; }
        public string CodItem          { get; set; } = string.Empty;
        public string Rubro            { get; set; } = string.Empty; // viene del ítem (lupa)
        public string Subrubro         { get; set; } = string.Empty; // viene del ítem (lupa)
        public decimal Cantidad        { get; set; }
        public string UnidadMedida     { get; set; } = string.Empty;   // valor seleccionado
        public List<string> UnidadesDisponibles { get; set; } = new(); // 0, 1 o 2 (unidad1/unidad2)
        public string Unidad1          { get; set; } = string.Empty;   // valor de unidad1 del ítem
        public string Unidad2          { get; set; } = string.Empty;   // valor de unidad2 del ítem
        public decimal CantidadUDM     { get; set; }
        public string ProveedorSugerido{ get; set; } = string.Empty;
        public string ObservacionItem  { get; set; } = string.Empty;
    }


    // ── Catálogo de items (modal lupa) ────────────────────────
    private class CatalogoItem
    {
        public string Codigo       { get; set; } = string.Empty;
        public string Descripcion  { get; set; } = string.Empty;
        public string Rubro        { get; set; } = string.Empty; // CODRUB
        public string Subrubro     { get; set; } = string.Empty; // CODSBR
        public string Unidad1      { get; set; } = string.Empty; // unidad1
        public string Unidad2      { get; set; } = string.Empty; // unidad2
    }

    private List<CatalogoItem> CatalogoItems { get; set; } = new();
    private string CatalogoError { get; set; } = string.Empty;

    private async Task CargarCatalogoItemsAsync()
    {
        try
        {
            var rows = await ReqService.GetCatalogoItemsAsync();
            CatalogoItems = rows
                .Select(r => new CatalogoItem
                {
                    Codigo      = r.Codigo,
                    Descripcion = r.Descripcion,
                    Rubro       = r.Rubro,
                    Subrubro    = r.Subrubro,
                    Unidad1     = r.Unidad1,
                    Unidad2     = r.Unidad2
                })
                .ToList();
            CatalogoError = string.Empty;
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"[ERROR catalogo items] {ex.Message}");
            CatalogoItems = new();
            CatalogoError = ex.Message;
        }
    }

    private bool   MostrarModalItems   { get; set; } = false;
    private string BusquedaItem        { get; set; } = string.Empty;
    private FilaItem? FilaParaCatalogo { get; set; }

    private IEnumerable<CatalogoItem> CatalogoItemsFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(BusquedaItem))
                return CatalogoItems;

            string q = BusquedaItem.Trim().ToLowerInvariant();
            return CatalogoItems.Where(i =>
                i.Codigo.ToLowerInvariant().Contains(q) ||
                i.Descripcion.ToLowerInvariant().Contains(q));
        }
    }

    private void AbrirModalItems(FilaItem fila)
    {
        FilaParaCatalogo  = fila;
        BusquedaItem      = string.Empty;
        MostrarModalItems = true;
    }

    private void CerrarModalItems()
    {
        MostrarModalItems = false;
        FilaParaCatalogo  = null;
        BusquedaItem      = string.Empty;
    }

    private void SeleccionarItemCatalogo(CatalogoItem item)
    {
        if (FilaParaCatalogo is null) return;

        // Autocompletado desde el ítem seleccionado (datos ya en memoria).
        FilaParaCatalogo.CodItem  = item.Codigo;
        FilaParaCatalogo.Rubro    = item.Rubro;      // ya viene "NA" si estaba vacío
        FilaParaCatalogo.Subrubro = item.Subrubro;   // ya viene "NA" si estaba vacío

        // Unidad de medida: se arman las opciones con unidad1 y unidad2 (solo las que traen valor).
        //   0 valores → "NA" (readonly)
        //   1 valor   → ese valor (readonly, como venía)
        //   2 valores → combobox para elegir
        var unidades = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.Unidad1)) unidades.Add(item.Unidad1.Trim());
        if (!string.IsNullOrWhiteSpace(item.Unidad2)) unidades.Add(item.Unidad2.Trim());

        FilaParaCatalogo.UnidadesDisponibles = unidades;
        FilaParaCatalogo.UnidadMedida        = unidades.Count == 0 ? "NA" : unidades[0];
        FilaParaCatalogo.Unidad1             = item.Unidad1?.Trim() ?? string.Empty;
        FilaParaCatalogo.Unidad2             = item.Unidad2?.Trim() ?? string.Empty;

        CerrarModalItems();
    }

    // ── Catálogo de proveedores (modal lupa) ──────────────────
    private class CatalogoProveedor
    {
        public string Codigo   { get; set; } = string.Empty;
        public string Nombre   { get; set; } = string.Empty;
        public string Fantasia { get; set; } = string.Empty;
    }

    private List<CatalogoProveedor> CatalogoProveedores { get; set; } = new();
    private string ProveedoresError { get; set; } = string.Empty;

    private async Task CargarCatalogoProveedoresAsync()
    {
        try
        {
            var rows = await ReqService.GetCatalogoProveedoresAsync();
            CatalogoProveedores = rows
                .Select(r => new CatalogoProveedor { Codigo = r.Codigo, Nombre = r.Nombre, Fantasia = r.Fantasia })
                .ToList();
            ProveedoresError = string.Empty;
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"[ERROR catalogo proveedores] {ex.Message}");
            CatalogoProveedores = new();
            ProveedoresError = ex.Message;
        }
    }

    private bool   MostrarModalProveedores  { get; set; } = false;
    private string BusquedaProveedor        { get; set; } = string.Empty;
    private FilaItem? FilaParaProveedor     { get; set; }

    private IEnumerable<CatalogoProveedor> CatalogoProveedoresFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(BusquedaProveedor))
                return CatalogoProveedores;

            string q = BusquedaProveedor.Trim().ToLowerInvariant();
            return CatalogoProveedores.Where(p =>
                p.Codigo.ToLowerInvariant().Contains(q)   ||
                p.Nombre.ToLowerInvariant().Contains(q)   ||
                p.Fantasia.ToLowerInvariant().Contains(q));
        }
    }

    private void AbrirModalProveedores(FilaItem fila)
    {
        FilaParaProveedor       = fila;
        BusquedaProveedor       = string.Empty;
        MostrarModalProveedores = true;
    }

    private void CerrarModalProveedores()
    {
        MostrarModalProveedores = false;
        FilaParaProveedor       = null;
        BusquedaProveedor       = string.Empty;
    }

    private void SeleccionarProveedorCatalogo(CatalogoProveedor prov)
    {
        if (FilaParaProveedor is null) return;

        FilaParaProveedor.ProveedorSugerido = prov.Codigo;

        CerrarModalProveedores();
    }

    // ── Variables del formulario header (UI) ──────────────────

    // N° de requerimiento con formato Prefijo-Correlativo (ej. 0001-00000001).
    // El Correlativo sale de TRANSAC (MAX(NROTRANS)+1); el Prefijo lo escribe el usuario.
    // BAS termina asignando el N° real al recibir el POST con Numero=0.
    private string NroRequerimiento { get; set; } = "N/A-00000001";
    private int    Correlativo      { get; set; } = 1;


    private string Departamento  { get; set; } = string.Empty; // TODO SQL (depto del usuario)
    private string Solicitante   { get; set; } = string.Empty; // opcional

    // Comentarios internos: campo nuevo, solo para el sector Compras (ver EsCompras).
    private string ComentariosInternosCompras { get; set; } = string.Empty;

    // El departamento del usuario habilita el campo de comentarios internos.
    // (Departamento hoy toma el usuario logueado; cuando se implemente el ajuste
    //  "Departamento según usuario" esta condición seguirá funcionando igual.)
    private bool EsCompras =>
        string.Equals(Departamento?.Trim(), "compras", StringComparison.OrdinalIgnoreCase);

    // ── Autorización adjunta (archivo PDF/JPG/PNG) ────────────────
    // El archivo NO se retiene en memoria: al seleccionarlo/arrastrarlo se escribe a
    // disco en una carpeta de staging y solo se guarda su RUTA. Todavía NO se sube a BAS
    // (pendiente de aprobación): cuando esté habilitado, se sube desde esa ruta.
    private static readonly string[] ExtensionesAdjuntoPermitidas = { ".png", ".jpg", ".jpeg", ".pdf" };
    private const long MaxTamanoAdjunto = 10 * 1024 * 1024; // 10 MB

    // Carpeta de staging para los adjuntos hasta que se suban a BAS.
    private static readonly string CarpetaAdjuntos =
        Path.Combine(Path.GetTempPath(), "SupplyOn", "adjuntos");

    private string RutaArchivoAutorizacion   = string.Empty; // ruta en disco (no en memoria)
    private string NombreArchivoAutorizacion = string.Empty; // nombre original mostrado al usuario
    private string TamanoArchivoAutorizacion = string.Empty;

    private async Task OnAutorizacionSeleccionada(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        string ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!ExtensionesAdjuntoPermitidas.Contains(ext))
        {
            LimpiarAutorizacion();
            Notif.Mostrar("Formato no permitido. Solo se aceptan PDF, JPG o PNG.", TipoNotificacion.Error);
            return;
        }

        if (file.Size > MaxTamanoAdjunto)
        {
            LimpiarAutorizacion();
            Notif.Mostrar("El archivo supera el tamaño máximo (10 MB).", TipoNotificacion.Error);
            return;
        }

        try
        {
            // Reemplazo: borro el adjunto anterior (si había) antes de guardar el nuevo.
            LimpiarAutorizacion();

            Directory.CreateDirectory(CarpetaAdjuntos);
            // Nombre único en disco para evitar colisiones; se conserva la extensión.
            string rutaDestino = Path.Combine(CarpetaAdjuntos, $"{Guid.NewGuid():N}{ext}");

            await using (var origen  = file.OpenReadStream(MaxTamanoAdjunto))
            await using (var destino = File.Create(rutaDestino))
            {
                await origen.CopyToAsync(destino);
            }

            RutaArchivoAutorizacion   = rutaDestino;
            NombreArchivoAutorizacion = file.Name;
            TamanoArchivoAutorizacion = FormatearTamano(file.Size);

            // Un adjunto válido limpia cualquier notificación de error previa.
            Notif.Limpiar();
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"[CreateReq] error guardando adjunto en disco: {ex.Message}");
            LimpiarAutorizacion();
            Notif.Mostrar("No se pudo guardar el archivo. Intentá de nuevo.", TipoNotificacion.Error);
        }
    }

    private void QuitarAutorizacion()
    {
        LimpiarAutorizacion();
    }

    private void LimpiarAutorizacion()
    {
        // Borra el archivo de staging del disco (si existe) y limpia el estado.
        if (!string.IsNullOrEmpty(RutaArchivoAutorizacion))
        {
            try
            {
                if (File.Exists(RutaArchivoAutorizacion))
                    File.Delete(RutaArchivoAutorizacion);
            }
            catch (Exception ex)
            {
                Debug.WriteLine($"[CreateReq] no se pudo borrar el adjunto de staging: {ex.Message}");
            }
        }
        RutaArchivoAutorizacion   = string.Empty;
        NombreArchivoAutorizacion = string.Empty;
        TamanoArchivoAutorizacion = string.Empty;
    }

    private static string FormatearTamano(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }
