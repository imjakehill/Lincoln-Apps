<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SupplyOn Blazor</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    <Configurations>Debug;Release;CMD</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="wwwroot\Assets\" />
  </ItemGroup>

  <ItemGroup>
    <!-- TODOBASWEBAPI es un proyecto independiente (.NET 10) y no debe compilarse junto al Blazor -->
    <Compile Remove="TODOBASWEBAPI\**" />
    <Content Remove="TODOBASWEBAPI\**" />
    <EmbeddedResource Remove="TODOBASWEBAPI\**" />
    <None Remove="TODOBASWEBAPI\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
  </ItemGroup>

</Project>
